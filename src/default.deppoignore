# Created by deppo.
# This file uses .gitignore syntax. Review it before the next run.
# A matching path is not uploaded. A line starting with ! keeps a path.
# Lines starting with # are comments. A trailing slash matches directories only.

# deppo cache. The ignore file itself is uploaded.
.deppocache
.deppocache.tmp
.deppocache.lock

